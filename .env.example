# ======================================================================
# Note2TimeSheet v2 - Template di configurazione
#
# Copia questo file in ".env" e compila i valori che ti servono.
# Tutte le variabili sono OPZIONALI: i valori del .env vengono usati come
# "seme" al primo avvio e poi salvati in data/settings.json. Da quel momento
# cio' che modifichi dalle Impostazioni nell'app ha la precedenza sul .env.
# Anche la chiave OpenAI puo' essere inserita dall'interfaccia
# (Impostazioni > Generale) invece che qui.
#
# NON committare mai il file .env (e' gia' nel .gitignore).
# ======================================================================

# ---- Server ----------------------------------------------------------
# Porta HTTP locale. La v2 usa 5600 (la v1 usava 5599) cosi' i due container
# Docker possono convivere sulla stessa macchina.
APP_PORT=5600

# Indirizzo su cui ascolta il server. 127.0.0.1 = solo questo PC (consigliato:
# l'app non ha login). Usa 0.0.0.0 per raggiungerla da altri dispositivi in rete.
# In Docker e' forzato a 0.0.0.0 (la porta e' comunque pubblicata solo su localhost).
APP_HOST=127.0.0.1

# Apri automaticamente il browser all'avvio (true/false). In Docker e' forzato a false.
AUTO_OPEN_BROWSER=true

# ---- Utente ----------------------------------------------------------
# Nome mostrato nell'app e passato all'AI (modificabile dalle Impostazioni).
USER_NAME=Il Tuo Nome

# Fuso orario (chiave IANA) usato per stabilire "che giorno e'" e per le riunioni.
TIMESHEET_TIMEZONE=Europe/Rome

# ---- OpenAI ----------------------------------------------------------
# Chiave API: https://platform.openai.com/api-keys
# Se la inserisci dall'interfaccia viene salvata in data/secrets.json e vince su questa.
OPENAI_API_KEY=

# Modello usato per l'elaborazione del timesheet.
OPENAI_MODEL=gpt-4.1-mini

# ---- GitHub (import commit / pull request / issue) -------------------
# Client ID di una OAuth App con "Device Flow" abilitato
# (https://github.com/settings/developers). Guida passo-passo nel README.
# In alternativa puoi collegare un Personal Access Token dalle Impostazioni.
GITHUB_CLIENT_ID=

# ---- Microsoft 365 (import riunioni dal calendario) ------------------
# App registration su Azure: public client + permesso delegato Calendars.Read.
# Guida passo-passo nel README.
GRAPH_CLIENT_ID=

# Tenant: "common" (qualsiasi account), "organizations", "consumers"
# oppure il Directory (tenant) ID della tua organizzazione.
GRAPH_TENANT_ID=common

# Account Outlook desktop per il fallback COM (solo Windows nativo, non in Docker).
# Lascia vuoto per usare il profilo Outlook predefinito.
OUTLOOK_ACCOUNT=

# ---- Cartella dati -----------------------------------------------------
# Dove salvare impostazioni, segreti, pratiche e storico. Consigliato: una
# cartella fuori dal progetto, ad esempio sul Desktop. Usa le barre "/".
#   TIMESHEET_HOST_DATA_DIR -> usata dal container Docker (montata su /app/data)
#   TIMESHEET_DATA_DIR      -> usata dall'avvio locale (start_timesheet.bat)
# Impostale uguali per condividere gli stessi dati tra Docker e avvio locale.
# Se le lasci vuote: Docker usa ./data, l'avvio locale usa ./data.
TIMESHEET_HOST_DATA_DIR=
TIMESHEET_DATA_DIR=

# ---- Avanzate (di norma non servono) ---------------------------------
# Cartella dati (default: ./data ; in Docker: /app/data)
# TIMESHEET_DATA_DIR=./data
# Giorni di storico da conservare (1-365, default 30)
# HISTORY_KEEP_DAYS=30
