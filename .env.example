# ============================================
# TIMESHEET APP v2 - Configurazione
# Copia questo file in .env e compila i valori
# ============================================

# Porta del server locale
APP_PORT=5599

# Nome utente (appare nell'app)
USER_NAME=Il Tuo Nome

# Account Outlook da usare (integrazione COM, solo in locale su Windows)
OUTLOOK_ACCOUNT=tuo@email.com

# ---- n8n (riunioni via flusso n8n, ha priorita' se impostato) ----
# L'app chiama questo webhook n8n che legge il calendario Microsoft (credenziali
# gia' configurate in n8n) e risponde con le riunioni. Funziona anche in Docker
# senza setup Azure lato app. Importa il flusso n8n/calendar-to-timesheet.json.
N8N_MEETINGS_URL=
# Token opzionale: se valorizzato viene inviato come header X-Timesheet-Token
N8N_MEETINGS_TOKEN=

# ---- Microsoft Graph (riunioni anche in Docker/server) ----
# Usato automaticamente quando n8n e Outlook COM non sono disponibili.
# Registra una "public client" su Azure AD con permesso delegato Calendars.Read.
# Lascia vuoto GRAPH_CLIENT_ID per disabilitare Graph.
GRAPH_CLIENT_ID=
# tenant: "common" (qualsiasi account), "organizations", "consumers" o un GUID
GRAPH_TENANT_ID=common

# OpenAI API Key (richiesta per elaborazione AI)
OPENAI_API_KEY=sk-...

# ---- Webhook n8n (opzionale, disabilitato di default) ----
ENABLE_WEBHOOK=false
WEBHOOK_URL=https://tuo-n8n.cloud/webhook/...
