    },
    {
      "parameters": {
        "jsType": "javaScript",
        "jsCode": "// Trasforma gli eventi di Microsoft Graph nel formato atteso dall'app.\nconst res = $input.first().json || {};\nconst events = Array.isArray(res.value) ? res.value : [];\n\nfunction parse(dt) {\n  if (!dt) return null;\n  const s = String(dt).replace('Z', '').split('.')[0];\n  const d = new Date(s + 'Z');\n  return isNaN(d.getTime()) ? null : d;\n}\n\nconst meetings = [];\nconst seen = new Set();\n\nfor (const ev of events) {\n  if (ev.isCancelled) continue;\n\n  const subject = String(ev.subject || '').trim() || 'Senza oggetto';\n  const isAllDay = !!ev.isAllDay;\n\n  let duration = 0;\n  if (isAllDay) {\n    duration = 480;\n  } else {\n    const s = parse(ev.start && ev.start.dateTime);\n    const e = parse(ev.end && ev.end.dateTime);\n    if (s && e) duration = Math.round((e - s) / 60000);\n  }\n\n  if (!isAllDay && duration < 5) continue;\n\n  const meeting_id = String(ev.id || subject);\n  if (seen.has(meeting_id)) continue;\n  seen.add(meeting_id);\n\n  meetings.push({\n    subject: subject,\n    duration: duration,\n    duration_label: isAllDay ? 'Tutto il giorno' : String(duration),\n    is_allday: isAllDay,\n    meeting_id: meeting_id,\n  });\n}\n\nreturn [{ json: { meetings: meetings } }];"
      },
